# Band platform
BAND_HUMAN_API_KEY=your-human-api-key
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Demo target
DEMO_APP_URL=http://localhost:8080
DEMO_APP_REPO=
GITHUB_TOKEN=

# OpenCode (all agents use this — start with: opencode serve)
DEFAULT_ADAPTER_TYPE=opencode
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER_ID=opencode
OPENCODE_MODEL=nemotron-3-ultra-free

# Per-role overrides (defaults to OPENCODE_MODEL)
ORCHESTRATOR_ADAPTER=opencode
ORCHESTRATOR_MODEL=nemotron-3-ultra-free
PLANNER_ADAPTER=opencode
PLANNER_MODEL=nemotron-3-ultra-free
CODER_ADAPTER=opencode
CODER_MODEL=nemotron-3-ultra-free
REVIEWER_ADAPTER=opencode
REVIEWER_MODEL=nemotron-3-ultra-free
COMPANY_AGENT_ADAPTER=opencode
COMPANY_AGENT_MODEL=nemotron-3-ultra-free
MERGER_ADAPTER=opencode
MERGER_MODEL=nemotron-3-ultra-free

BIG_REPO_FILE_THRESHOLD=150
REVIEW_MAX_ROUNDS=3

# Watchdog
WATCHDOG_POLL_INTERVAL_S=5
WATCHDOG_FAILURE_THRESHOLD=2
WATCHDOG_HEALTH_TIMEOUT_S=5
WATCHDOG_HEALTH_RETRIES=1
