# Band platform
BAND_HUMAN_API_KEY=your-human-api-key
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Demo target
DEMO_APP_URL=http://localhost:8080
DEMO_APP_REPO=https://github.com/kalki-kgp/bandaid-demo-app
GITHUB_TOKEN=

# Claude Code CLI model for Commander, Scribe, Fix Engineer (sonnet | opus | haiku)
CLAUDE_CODE_MODEL=sonnet

# LLM providers (optional — not needed if using Claude Code CLI + Codex CLI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=sk-xxx
FEATHERLESS_API_KEY=fn-xxx
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Llama-3.3-70B-Instruct
AIML_API_KEY=your-aiml-api-key
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini

# Watchdog
WATCHDOG_POLL_INTERVAL_S=5
WATCHDOG_FAILURE_THRESHOLD=2
WATCHDOG_HEALTH_TIMEOUT_S=5
WATCHDOG_HEALTH_RETRIES=1
